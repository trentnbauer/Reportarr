# Copy to .env (git-ignored) and fill in. Docker Compose reads it automatically.
# Never commit the real .env: it holds your Plex token and API keys.

# --- Plex ---
PLEX_URL=http://plex:32400
# Plex server owner's token. Needed to read Reported Issues.
PLEX_TOKEN=

# --- Sonarr / Radarr ---
# Include any URL base path, for example http://sonarr:8989/sonarr
SONARR_URL=http://sonarr:8989
SONARR_KEY=
RADARR_URL=http://radarr:7878
RADARR_KEY=

# --- Behaviour ---
# Keep true until the Changes table in the UI looks right, then set false to really delete and re-download.
DRY_RUN=true
POLL_SECONDS=60
MAX_PER_DAY=48

# --- Web UI ---
WEB_UI=8080
# HTTP basic auth. Set both: the app holds your Plex token and can delete files.
# If UI_USERNAME is blank, any username is accepted and only the password is checked.
UI_USERNAME=
UI_PASSWORD=

# --- Optional: move the replacement to the top of the download queue ---
# Sonarr/Radarr hide these from their API, so Reportarr needs its own copy. Leave blank to skip.
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=
SAB_URL=
# SABnzbd's full API key, not the NZB key.
SAB_API_KEY=
