# Copy to .env (git-ignored) next to docker-compose.yml, or configure Reportarr in the web UI and use "Download .env".
# Never commit the real .env: it holds your Plex token and API keys.
# Anything set here is locked (read-only) in the web UI.

# --- Plex ---
PLEX_URL=http://plex:32400
# Plex server owner's token. Needed to read Reported Issues.
PLEX_KEY=
# More Plex servers (any number): PLEX_2_NAME, PLEX_2_URL, PLEX_2_KEY, PLEX_3_*, ...
# PLEX_2_NAME=family
# PLEX_2_URL=http://10.0.0.20:32400
# PLEX_2_KEY=

# --- Sonarr / Radarr ---
# As many as you have: number them 1, 2, 3, ... (SONARR_3_URL, RADARR_4_KEY, and so on). Include any URL base path.
# SONARR_1_NAME is optional and sets the display name (default sonarr-1).
SONARR_1_URL=http://sonarr:8989
SONARR_1_KEY=
# SONARR_2_URL=http://sonarr4k:8989
# SONARR_2_KEY=
RADARR_1_URL=http://radarr:7878
RADARR_1_KEY=
# RADARR_2_URL=http://radarr4k:7878
# RADARR_2_KEY=

# --- Lidarr (music), optional. Plex music reports replace the whole album. ---
# LIDARR_1_URL=http://lidarr:8686
# LIDARR_1_KEY=

# --- Overseerr / Seerr (optional second source of reports) ---
OVERSEERR_URL=
OVERSEERR_KEY=
# Which issue types replace the file: video, audio, subtitles, other
OVERSEERR_ISSUE_TYPES=video,audio,other
# Comment on and resolve the issue after replacing
OVERSEERR_RESOLVE=true
# More Overseerr/Seerr instances (any number): OVERSEERR_2_NAME, OVERSEERR_2_URL, OVERSEERR_2_KEY, OVERSEERR_2_ISSUE_TYPES, OVERSEERR_2_RESOLVE, ...

# --- Behaviour ---
# Keep true until the Changes table in the UI looks right, then set false to really delete and re-download.
DRY_RUN=true
POLL_SECONDS=60
MAX_PER_HOUR=10

# --- Web UI ---
WEB_UI=8080
# Only if a reverse proxy serves it under a path (see the README): /reportarr or https://media.example.com/reportarr
BASE_URL=
# Login for the web UI (HTTP basic auth). Set both: the app holds your Plex token and can delete files.
# If UI_PASSWORD is blank there is NO login and the page just loads (the UI shows a warning). A username alone does not turn it on.
# If UI_USERNAME is blank but UI_PASSWORD is set, any username is accepted and only the password is checked.
UI_USERNAME=
UI_PASSWORD=
# Hide the "No login is set" banner (only shown when UI_PASSWORD is blank)
HIDE_LOGIN_WARNING=false

# --- Optional: move the replacement to the top of the download queue ---
# Sonarr/Radarr hide these from their API, so Reportarr needs its own copy. Leave blank to skip.
# For several qBittorrent/SABnzbd instances use CLIENTS (a JSON list), see the README.
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=
SAB_URL=
# SABnzbd's full API key, not the NZB key.
SAB_API_KEY=
